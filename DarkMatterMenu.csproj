<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DarkMatterMenu</AssemblyName>
    <RootNamespace>DarkMatterMenu</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CHANGE THIS to your BONELAB install folder (the one containing MelonLoader, Mods, UserLibs) -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\BONELAB</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader + Il2Cpp interop -->
    <Reference Include="$(GameDir)\MelonLoader\net6\*.dll" Private="false" />
    <!-- Game + Unity assemblies generated by MelonLoader on first launch -->
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
    <!-- BoneLib -->
    <Reference Include="$(GameDir)\Mods\BoneLib.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the finished mod straight into the game's Mods folder -->
  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)DarkMatterMenu.dll" DestinationFolder="$(GameDir)\Mods" ContinueOnError="true" />
  </Target>

</Project>
